<?xml version="1.0" encoding="UTF-8"?>
<!--
  Supressoes do OWASP Dependency-Check.

  REGRA: nenhuma supressao sem justificativa escrita e sem data de revisao.
  Uma supressao declara "esta CVE nao e explorevel NESTE contexto", nunca
  "esta CVE e inconveniente". Se nao houver argumento tecnico, corrija a
  dependencia em vez de suprimir.

  Formato de cada entrada:
    <notes>
      CVE:        identificador
      Motivo:     por que nao e explorevel aqui
      Revisar em: AAAA-MM-DD
      Autor:      quem decidiu
    </notes>

  Este arquivo comeca vazio de proposito. A primeira execucao do
  security.yml vai listar os achados reais; cada um deve ser tratado
  (corrigido ou suprimido com justificativa), nunca ignorado em silencio.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <suppress>
        <notes><![CDATA[
          CVE:        CVE-2026-65898
          Motivo:     falso positivo de correspondencia de CPE. A CVE afeta o DOMPurify
                      nas versoes 3.4.7 a 3.4.10 (pollution de ALLOWED_ATTR via
                      setConfig()). O swagger-ui embutido pelo springdoc-openapi
                      (springdoc-openapi-starter-webmvc-ui:2.8.17) resolve o
                      DOMPurify em 3.3.2, fora do intervalo afetado; confirmado via
                      mvn dependency:tree. Revisar ao subir o springdoc novamente,
                      caso a versao do DOMPurify embutida mude.
          Revisar em: 2027-02-28
          Autor:      israel.barcelos
        ]]></notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <vulnerabilityName>CVE-2026-65898</vulnerabilityName>
    </suppress>

